msgid "to"
msgstr "bis"

#: .\apps\absences\models.py:177 .\templates\organisation\closures.html:41
msgid "comes out of their leave"
msgstr "geht vom Urlaub ab"

#: .\apps\absences\models.py:178
msgid "Off for a day the employer closes and pays for."
msgstr "Aus, wenn der Betrieb schließt und den Tag bezahlt."

#: .\apps\absences\models.py:183
msgid "closure"
msgstr "Schließzeit"

#: .\apps\absences\models.py:184
msgid "closures"
msgstr "Schließzeiten"

#: .\apps\absences\models.py:230
msgid "reason"
msgstr "Anmerkung"

#: .\apps\absences\models.py:237
msgid "which"
msgstr "welcher"

#: .\apps\absences\models.py:260
msgid "half a day"
msgstr "halber Tag"

#: .\apps\absences\models.py:261
msgid "Half of that one day. Only for a single date."
msgstr "Die Hälfte dieses einen Tages. Nur für ein einzelnes Datum."

#: .\apps\absences\models.py:265
msgid "status"
msgstr "Status"

#: .\apps\absences\models.py:280
msgid "absence"
msgstr "Abwesenheit"

#: .\apps\absences\models.py:281
msgid "absences"
msgstr "Abwesenheiten"

#: .\apps\absences\models.py:297
msgid "Say which special leave this is, or it cannot be counted."
msgstr "Bitte angeben, um welchen Sonderurlaub es sich handelt — sonst kann er nicht angerechnet werden."

#: .\apps\absences\models.py:302
msgid "A half day is one date. Book the whole days as one absence and the half day as another."
msgstr "Ein halber Tag ist ein einzelnes Datum. Erfassen Sie die ganzen Tage als eine Abwesenheit und den halben Tag als eine zweite."

#: .\apps\absences\models.py:311
msgid "Only special leave names a leave type."
msgstr "Nur Sonderurlaub nennt eine Urlaubsart."

#: .\apps\absences\views.py:96
msgid "Your request was sent for approval. It shows as waiting until your manager decides, and the days are not taken off your balance before then."
msgstr "Ihr Antrag wurde zur Genehmigung weitergeleitet. Er steht auf „wartet“, bis Ihre Leitung entscheidet; bis dahin werden die Tage nicht von Ihrem Guthaben abgezogen."

#: .\apps\absences\views.py:115
msgid "That is not something you can withdraw."
msgstr "Das können Sie nicht zurückziehen."

#: .\apps\absences\views.py:123
msgid "Your manager has already seen that. Ask them to correct the dates."
msgstr "Ihre Leitung hat das bereits gesehen. Bitten Sie sie, die Daten zu korrigieren."

#: .\apps\absences\views.py:128
msgid "That time off has already started. Ask your manager to change it."
msgstr "Diese Abwesenheit hat bereits begonnen. Bitte wenden Sie sich an Ihre Leitung."

#: .\apps\absences\views.py:134
msgid "The request was withdrawn."
msgstr "Der Antrag wurde zurückgezogen."

#: .\apps\absences\views.py:150
msgid "Recorded, and your manager has been shown it. It counts from now — it does not come out of your leave, the hours are credited, and the days you were not due to work are not counted."
msgstr "Erfasst, und Ihrer Leitung angezeigt. Es zählt ab sofort — es geht nicht von Ihrem Urlaub ab, die Stunden werden gutgeschrieben, und Tage, an denen Sie nicht eingeteilt waren, werden nicht gezählt."

#: .\apps\absences\views.py:155
msgid "Those dates could not be read."
msgstr "Diese Daten konnten nicht gelesen werden."

#: .\apps\absences\views.py:175
msgid "That date could not be read."
msgstr "Dieses Datum konnte nicht gelesen werden."

#: .\apps\absences\views.py:179
msgid "That is before the illness started."
msgstr "Das liegt vor dem Beginn der Krankheit."

#: .\apps\absences\views.py:184
msgid "Thank you — the sickness is recorded as ended."
msgstr "Danke — die Krankheit ist als beendet eingetragen."

#: .\apps\absences\views.py:237
msgid "That request has already been decided."
msgstr "Über diesen Antrag wurde bereits entschieden."

#: .\apps\absences\views.py:242
msgid "That could not be saved."
msgstr "Das konnte nicht gespeichert werden."

#: .\apps\absences\views.py:255
#, python-format
msgid "%(who)s’s sickness was acknowledged."
msgstr "Die Krankmeldung von %(who)s wurde zur Kenntnis genommen."

#: .\apps\absences\views.py:260
#, python-format
msgid "%(who)s’s sickness was recorded as not accepted, and they were told why. Those days no longer count as time worked."
msgstr "Die Krankmeldung von %(who)s wurde als nicht anerkannt erfasst, mit Begründung. Diese Tage zählen nicht mehr als Arbeitszeit."

#: .\apps\absences\views.py:264
#, python-format
msgid "%(who)s’s time off was approved."
msgstr "Die Abwesenheit von %(who)s wurde genehmigt."

#: .\apps\absences\views.py:268
#, python-format
msgid "%(who)s’s request was declined and they were told why."
msgstr "Der Antrag von %(who)s wurde abgelehnt, mit Begründung."

#: .\apps\absences\views.py:373
#, python-format
msgid "%(count)s people are carrying days into %(next_year)s."
msgstr "%(count)s Personen nehmen Resttage mit in das Jahr %(next_year)s."

#: .\apps\absences\views.py:379
msgid "No reminder date was recorded, so the statutory days are treated as not expiring. Tell each person what they have left and that it will lapse, then record the date here."
msgstr "Es wurde kein Hinweisdatum erfasst, daher gelten die gesetzlichen Tage als nicht verfallend. Teilen Sie jeder Person mit, wie viele Tage offen sind und dass diese verfallen, und tragen Sie das Datum hier ein."

#: .\apps\absences\views.py:384
#, python-format
msgid "Nobody has days left over from %(year)s."
msgstr "Aus %(year)s sind bei niemandem Tage offen geblieben."

#: .\apps\absences\views.py:404
#, python-format
msgid "The deadline is %(date)s and it has not passed. Those days are still theirs to take."
msgstr "Die Frist ist der %(date)s und noch nicht abgelaufen. Diese Tage stehen weiterhin zu."

#: .\apps\absences\views.py:412
#, python-format
msgid "%(count)s people lost carried-over days, and each row records what went and when."
msgstr "Bei %(count)s Personen sind übertragene Tage verfallen; jede Zeile hält fest, wie viele und wann."

#: .\apps\absences\views.py:416
msgid "There was nothing left to lapse."
msgstr "Es war nichts mehr da, was verfallen konnte."

#: .\apps\absences\views.py:442
msgid "The reminder date was recorded."
msgstr "Das Hinweisdatum wurde erfasst."

#: .\apps\absences\views.py:444
msgid "No new date was given, so nothing was changed."
msgstr "Es wurde kein neues Datum angegeben, daher wurde nichts geändert."

#: .\apps\absences\views.py:453
#, python-format
msgid "%(who)s’s deadline was moved, and the reason recorded."
msgstr "Die Frist von %(who)s wurde verschoben, mit Begründung."

