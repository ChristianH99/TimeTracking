msgid "lapsed %(date)s"
msgstr "verfallen am %(date)s"

#: .\templates\absences\year_end.html:81
msgid "They were not told, so these days do not expire."
msgstr "Die Person wurde nicht informiert, daher verfallen diese Tage nicht."

#: .\templates\absences\year_end.html:82
msgid "no reminder sent"
msgstr "kein Hinweis versendet"

#: .\templates\absences\year_end.html:87
