msgid "date"
msgstr "Datum"

#: .\apps\absences\models.py:95 .\apps\absences\models.py:173
#: .\apps\organisation\models.py:554
msgid "name"
msgstr "Name"

#: .\apps\absences\models.py:98
msgid "Generated rows are replaced when the year is generated again; added ones are not."
msgstr "Berechnete Einträge werden beim erneuten Erzeugen des Jahres ersetzt, von Hand hinzugefügte nicht."

#: .\apps\absences\models.py:103
msgid "public holiday"
msgstr "Feiertag"

#: .\apps\absences\models.py:104
msgid "public holidays"
msgstr "Feiertage"

#: .\apps\absences\models.py:174 .\apps\absences\models.py:244
