msgid "Authorisation"
msgstr "Autorisierung"

#: .\apps\accounts\sso_views.py:189
msgid "Token"
msgstr "Token"

#: .\apps\accounts\sso_views.py:190
msgid "User info"
msgstr "Benutzerinfo"

#: .\apps\accounts\sso_views.py:191
msgid "JWKS"
msgstr "JWKS"

#: .\apps\accounts\sso_views.py:224
msgid "there is no SSO server address to look at"
msgstr "es ist keine SSO-Server-Adresse hinterlegt"

#: .\apps\accounts\sso_views.py:235
msgid "it answered, but with nothing that looks like a discovery document"
msgstr "es kam eine Antwort, aber nichts, was wie ein Discovery-Dokument aussieht"

#: .\apps\accounts\sso_views.py:300
