#: .\static\js\roster_plan.js:594
#, javascript-format
msgid "Remove %s?"
msgstr "%s entfernen?"

#: .\static\js\roster_plan.js:598
#, javascript-format
msgid "People placed in it: %s. They are taken out with it."
msgstr "Darin eingeteilte Personen: %s. Sie werden mit herausgenommen."

#: .\static\js\roster_plan.js:599
msgid "Remove"
msgstr "Entfernen"

#: .\static\js\roster_plan.js:674
#, javascript-format
msgid "Times for %s"
msgstr "Zeiten für %s"

#: .\static\js\roster_plan.js:676
msgid "%(day)s, time range %(range)s. Enter the exact times this person works; the cell then shows only the time that differs."
msgstr "%(day)s, Zeitraum %(range)s. Geben Sie die genauen Zeiten dieser Person ein; die Zelle zeigt dann nur die abweichende Zeit."

#: .\static\js\roster_plan.js:695 .\static\js\timeinput.js:65
msgid "That is not a time this app can read. Try 8:30, 8,5 or 830."
msgstr "Das ist keine Zeitangabe, die diese App lesen kann. Versuchen Sie 8:30, 8,5 oder 830."

#: .\static\js\roster_plan.js:700
msgid "The times need a length."
msgstr "Die Zeiten brauchen eine Dauer."

#: .\static\js\roster_plan.js:1055
msgid "Edit area"
msgstr "Bereich bearbeiten"

#: .\static\js\roster_plan.js:1055
msgid "New area"
msgstr "Neuer Bereich"

#: .\static\js\roster_plan.js:1069
msgid "That did not work. Please try again."
msgstr "Das hat nicht geklappt. Bitte versuchen Sie es erneut."

#: .\static\js\roster_plan.js:1089
msgid "An area needs a name."
msgstr "Ein Bereich braucht einen Namen."

#: .\static\js\roster_plan.js:1129
#, javascript-format
msgid "Delete %s?"
msgstr "%s löschen?"

#: .\static\js\roster_plan.js:1130
msgid "Only an area no week has used can be deleted. Anybody placed in it on this page moves to the first remaining cell of its time range."
msgstr "Löschen lässt sich nur ein Bereich, der in keiner Woche vorkommt. Wer auf dieser Seite darin eingeteilt ist, rückt in die erste verbleibende Zelle des Zeitraums."

#: .\static\js\roster_plan.js:1131
msgid "Delete"
msgstr "Löschen"

#: .\static\js\shell.js:175 .\static\js\shell.js:184
msgid "OK"
msgstr "OK"

#: .\static\js\shell.js:182 .\static\js\shell.js:289
msgid "Continue"
msgstr "Weiter"

#: .\static\js\shell.js:380
msgid "Dismiss"
msgstr "Schließen"

#: .\static\js\shell.js:463
msgid "Copied"
msgstr "Kopiert"

#: .\static\js\shell.js:464 .\static\js\shell.js:469
msgid "Press Ctrl-C"
msgstr "Strg-C drücken"

#: .\static\js\timesheet_day.js:45
msgid "running"
msgstr "läuft"

