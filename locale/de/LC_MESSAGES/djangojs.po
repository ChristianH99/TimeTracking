#: .\static\js\roster_plan.js:594
#, javascript-format
msgid "Remove %s?"
msgstr "%s entfernen?"

#: .\static\js\roster_plan.js:598
#, javascript-format
msgid "People placed in it: %s. They are taken out with it."
msgstr "Darin eingeteilte Personen: %s. Sie werden mit herausgenommen."

#: .\static\js\roster_plan.js:599
msgid "Remove"
msgstr "Entfernen"

#: .\static\js\roster_plan.js:674
#, javascript-format
msgid "Times for %s"
msgstr "Zeiten für %s"

#: .\static\js\roster_plan.js:676
msgid "%(day)s, time range %(range)s. Enter the exact times this person works; the cell then shows only the time that differs."
msgstr "%(day)s, Zeitraum %(range)s. Geben Sie die genauen Zeiten dieser Person ein; die Zelle zeigt dann nur die abweichende Zeit."

#: .\static\js\roster_plan.js:695 .\static\js\timeinput.js:65
#: .\static\js\timesheet_month.js:547
msgid "That is not a time this app can read. Try 8:30, 8,5 or 830."
msgstr "Das ist keine Zeitangabe, die diese App lesen kann. Versuchen Sie 8:30, 8,5 oder 830."

#: .\static\js\roster_plan.js:700
msgid "The times need a length."
msgstr "Die Zeiten brauchen eine Dauer."

#: .\static\js\roster_plan.js:1055
msgid "Edit area"
msgstr "Bereich bearbeiten"

#: .\static\js\roster_plan.js:1055
msgid "New area"
msgstr "Neuer Bereich"

#: .\static\js\roster_plan.js:1069
msgid "That did not work. Please try again."
msgstr "Das hat nicht geklappt. Bitte versuchen Sie es erneut."

#: .\static\js\roster_plan.js:1089
msgid "An area needs a name."
msgstr "Ein Bereich braucht einen Namen."

#: .\static\js\roster_plan.js:1129
#, javascript-format
msgid "Delete %s?"
msgstr "%s löschen?"

#: .\static\js\roster_plan.js:1130
msgid "Only an area no week has used can be deleted. Anybody placed in it on this page moves to the first remaining cell of its time range."
msgstr "Löschen lässt sich nur ein Bereich, der in keiner Woche vorkommt. Wer auf dieser Seite darin eingeteilt ist, rückt in die erste verbleibende Zelle des Zeitraums."

#: .\static\js\roster_plan.js:1131
msgid "Delete"
msgstr "Löschen"

#: .\static\js\shell.js:175 .\static\js\shell.js:184
msgid "OK"
msgstr "OK"

#: .\static\js\shell.js:182 .\static\js\shell.js:298
msgid "Continue"
msgstr "Weiter"

#: .\static\js\shell.js:389
msgid "Dismiss"
msgstr "Schließen"

#: .\static\js\shell.js:532
msgid "Copied"
msgstr "Kopiert"

#: .\static\js\shell.js:533 .\static\js\shell.js:538
msgid "Press Ctrl-C"
msgstr "Strg-C drücken"

#: .\static\js\timesheet_day.js:45
msgid "running"
msgstr "läuft"

#: .\static\js\timesheet_day.js:128
msgid "This overlaps another stretch on the same day."
msgstr "Das überschneidet sich mit einem anderen Abschnitt am selben Tag."

#: .\static\js\timesheet_month.js:50
msgid "Coming"
msgstr "Kommen"

#: .\static\js\timesheet_month.js:51
msgid "Going"
msgstr "Gehen"

#: .\static\js\timesheet_month.js:156
msgid "That could not be saved."
msgstr "Das konnte nicht gespeichert werden."

#: .\static\js\timesheet_month.js:165
msgid "The change did not reach the server, so nothing was saved."
msgstr "Die Änderung hat den Server nicht erreicht, es wurde also nichts gespeichert."

#: .\static\js\timesheet_month.js:282
msgid "Credited, not worked — an absence the hours are paid for."
msgstr "Gutgeschrieben, nicht gearbeitet — eine Abwesenheit, die bezahlt wird."

#: .\static\js\timesheet_month.js:301
msgid "Working time limit"
msgstr "Arbeitszeitgrenze"

#: .\static\js\timesheet_month.js:325
msgid "still running"
msgstr "läuft noch"

#: .\static\js\timesheet_month.js:327
msgid "differs"
msgstr "weicht ab"

#: .\static\js\timesheet_month.js:328
msgid "The hours entered are not the hours rostered."
msgstr "Die eingetragenen Zeiten sind nicht die geplanten Zeiten."

#: .\static\js\timesheet_month.js:425
msgid "Time"
msgstr "Zeit"

#: .\static\js\timesheet_month.js:448
msgid "Remove this booking"
msgstr "Diese Buchung entfernen"

#: .\static\js\timesheet_month.js:540
msgid "Every booking has to say whether it is a coming or a going."
msgstr "Bei jeder Buchung muss angegeben sein, ob sie ein Kommen oder ein Gehen ist."

#: .\static\js\timesheet_month.js:543
msgid "There is a booking with no time on it."
msgstr "Es gibt eine Buchung ohne Uhrzeit."

#: .\static\js\timesheet_month.js:551
msgid "There are two comings in a row with no going between them."
msgstr "Es stehen zwei Kommen hintereinander, ohne ein Gehen dazwischen."

#: .\static\js\timesheet_month.js:557
msgid "There is a going with no coming before it. A day starts with a coming."
msgstr "Es gibt ein Gehen, vor dem kein Kommen steht. Ein Tag beginnt mit einem Kommen."

#: .\static\js\timesheet_month.js:560
msgid "A coming and a going at the same moment is a stretch with no length."
msgstr "Ein Kommen und ein Gehen zum selben Zeitpunkt ist ein Abschnitt ohne Länge."

#: .\static\js\timesheet_month.js:711 .\static\js\timesheet_month.js:930
#: .\static\js\timesheet_month.js:963
msgid "Saved."
msgstr "Gespeichert."

#: .\static\js\timesheet_month.js:795
msgid "That is not a length this app can read. Try 30, 0:30 or -15."
msgstr "Das ist keine Dauer, die diese App lesen kann. Zum Beispiel 30, 0:30 oder -15."

#: .\static\js\timesheet_month.js:802
msgid "Say why the day was corrected. A correction nobody can account for is the one entry on a timesheet that cannot be defended."
msgstr "Bitte angeben, warum der Tag korrigiert wurde. Eine Korrektur, die niemand begründen kann, ist der eine Eintrag auf einem Stundenzettel, der sich nicht verteidigen lässt."
