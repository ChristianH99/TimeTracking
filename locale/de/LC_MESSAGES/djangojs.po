#: .\static\js\shell.js:175 .\static\js\shell.js:184
msgid "OK"
msgstr "OK"

#: .\static\js\shell.js:182 .\static\js\shell.js:289
msgid "Continue"
msgstr "Weiter"

#: .\static\js\shell.js:380
msgid "Dismiss"
msgstr "Schließen"

#: .\static\js\shell.js:523
msgid "Copied"
msgstr "Kopiert"

#: .\static\js\shell.js:524 .\static\js\shell.js:529
msgid "Press Ctrl-C"
msgstr "Strg-C drücken"

#: .\static\js\timeinput.js:65 .\static\js\timesheet_month.js:491
msgid "That is not a time this app can read. Try 8:30, 8,5 or 830."
msgstr "Das ist keine Zeitangabe, die diese App lesen kann. Versuchen Sie 8:30, 8,5 oder 830."

#: .\static\js\timesheet_day.js:45
msgid "running"
msgstr "läuft"

#: .\static\js\timesheet_day.js:128
msgid "This overlaps another stretch on the same day."
msgstr "Das überschneidet sich mit einem anderen Abschnitt am selben Tag."

#: .\static\js\timesheet_month.js:50
msgid "Coming"
msgstr "Kommen"

#: .\static\js\timesheet_month.js:51
msgid "Going"
msgstr "Gehen"

#: .\static\js\timesheet_month.js:156
msgid "That could not be saved."
msgstr "Das konnte nicht gespeichert werden."

#: .\static\js\timesheet_month.js:165
msgid "The change did not reach the server, so nothing was saved."
msgstr "Die Änderung hat den Server nicht erreicht, es wurde also nichts gespeichert."

#: .\static\js\timesheet_month.js:224
msgid "add"
msgstr "eintragen"

#: .\static\js\timesheet_month.js:276
msgid "Credited, not worked — an absence the hours are paid for."
msgstr "Gutgeschrieben, nicht gearbeitet — eine Abwesenheit, die bezahlt wird."

#: .\static\js\timesheet_month.js:301
msgid "still running"
msgstr "läuft noch"

#: .\static\js\timesheet_month.js:303
msgid "differs"
msgstr "weicht ab"

#: .\static\js\timesheet_month.js:304
msgid "The hours entered are not the hours rostered."
msgstr "Die eingetragenen Zeiten sind nicht die geplanten Zeiten."

#: .\static\js\timesheet_month.js:375
msgid "Time"
msgstr "Zeit"

#: .\static\js\timesheet_month.js:398
msgid "Remove this booking"
msgstr "Diese Buchung entfernen"

#: .\static\js\timesheet_month.js:484
msgid "Every booking has to say whether it is a coming or a going."
msgstr "Bei jeder Buchung muss angegeben sein, ob sie ein Kommen oder ein Gehen ist."

#: .\static\js\timesheet_month.js:487
msgid "There is a booking with no time on it."
msgstr "Es gibt eine Buchung ohne Uhrzeit."

#: .\static\js\timesheet_month.js:495
msgid "There are two comings in a row with no going between them."
msgstr "Es stehen zwei Kommen hintereinander, ohne ein Gehen dazwischen."

#: .\static\js\timesheet_month.js:501
msgid "There is a going with no coming before it. A day starts with a coming."
msgstr "Es gibt ein Gehen, vor dem kein Kommen steht. Ein Tag beginnt mit einem Kommen."

#: .\static\js\timesheet_month.js:504
msgid "A coming and a going at the same moment is a stretch with no length."
msgstr "Ein Kommen und ein Gehen zum selben Zeitpunkt ist ein Abschnitt ohne Länge."

#: .\static\js\timesheet_month.js:655 .\static\js\timesheet_month.js:852
#: .\static\js\timesheet_month.js:885
msgid "Saved."
msgstr "Gespeichert."

#: .\static\js\timesheet_month.js:739
msgid "That is not a length this app can read. Try 30, 0:30 or -15."
msgstr "Das ist keine Dauer, die diese App lesen kann. Zum Beispiel 30, 0:30 oder -15."

#: .\static\js\timesheet_month.js:746
msgid "Say why the day was corrected. A correction nobody can account for is the one entry on a timesheet that cannot be defended."
msgstr "Bitte angeben, warum der Tag korrigiert wurde. Eine Korrektur, die niemand begründen kann, ist der eine Eintrag auf einem Stundenzettel, der sich nicht verteidigen lässt."
